pipeline {
    agent any
    environment {
        AWS_ACCOUNT_ID = '435240837203' 
        AWS_REGION     = 'ap-south-1'
        ECR_REPO       = 'storevault'
        EKS_CLUSTER    = 'storevault-production-cluster'
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }
    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/shravanipatil35/Storevault.git'
            }
        }
        stage('Docker Build & Tag') {
            steps {
                script {
                    sh "docker build -t ${ECR_REPO}:${BUILD_NUMBER} ."
                    sh "docker tag ${ECR_REPO}:${BUILD_NUMBER} ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER}"
                    sh "docker tag ${ECR_REPO}:${BUILD_NUMBER} ${ECR_REGISTRY}/${ECR_REPO}:latest"
                }
            }
        }
        stage('Secure Push to AWS ECR') {
            steps {
                script {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                    sh "docker push ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER}"
                    sh "docker push ${ECR_REGISTRY}/${ECR_REPO}:latest"
                }
            }
        }
        stage('Rollout to EKS Cluster') {
            steps {
                script {
                    sh "aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER}"
                    def rdsEndpoint = sh(script: "aws rds describe-db-instances --db-instance-identifier storevault-production-db --region ${AWS_REGION} --query 'DBInstances[0].Endpoint.Address' --output text", returnStdout: true).trim()
                    sh "sed -i 's/AWS_ACCOUNT_ID_PLACEHOLDER/${AWS_ACCOUNT_ID}/g' k8s/serviceaccount.yaml"
                    sh "sed -i 's/AWS_ACCOUNT_ID_PLACEHOLDER/${AWS_ACCOUNT_ID}/g' k8s/deployment.yaml"
                    sh "sed -i 's/AWS_REGION_PLACEHOLDER/${AWS_REGION}/g' k8s/deployment.yaml"
                    sh "sed -i 's/DATABASE_HOST_PLACEHOLDER/${rdsEndpoint}/g' k8s/deployment.yaml"
                    sh "kubectl apply -f k8s/"
                    sh "kubectl set image deployment/storevault-deployment application-container=${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER}"
                    sh "kubectl rollout status deployment/storevault-deployment"
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}